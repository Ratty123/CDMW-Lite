<Application x:Class="Cdmw.ArchiveLite.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Graphite.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <!-- Seeded so the shell resolves a face before a language is applied; UiFontManager
                 replaces both keys with the stack the active language needs. -->
            <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
