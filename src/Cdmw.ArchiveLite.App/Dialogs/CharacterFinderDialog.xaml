<Window x:Class="Cdmw.ArchiveLite.App.Dialogs.CharacterFinderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Cdmw.ArchiveLite.App.Infrastructure"
        xmlns:controls="clr-namespace:Cdmw.ArchiveLite.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{infra:Loc Key=CharacterFinderTitle}" Width="1320" Height="840" MinWidth="1040" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <TextBlock Margin="18,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource TitleFontSize}" Text="{infra:Loc Key=CharacterFinderTitle}" />
                <Border Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" />
                <Button Grid.Column="1" Content="&#x00D7;" FontSize="18" MinWidth="0" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="{infra:Loc Key=Close}" Click="OnCloseClick" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="14,12,14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Tabs}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Tab}" />
                <ComboBox Grid.Column="1" MinWidth="175" Margin="0,0,8,0" ItemsSource="{Binding Views}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding View}" />
                <TextBox x:Name="SearchBox" Grid.Column="2" Margin="0,0,8,0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="{infra:Loc Key=CharacterSearchHint}" KeyDown="OnSearchKeyDown" />
                <Button Grid.Column="3" Margin="0,0,8,0" Content="{infra:Loc Key=Search}" Command="{Binding SearchCommand}" />
                <Button Grid.Column="4" Content="{infra:Loc Key=Clear}" Command="{Binding ClearCommand}" />
            </Grid>
            <UniformGrid Columns="4" Margin="0,8,0,0">
                <ComboBox Margin="0,0,8,0" ItemsSource="{Binding Roles}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRole}" />
                <ComboBox Margin="0,0,8,0" ItemsSource="{Binding Sources}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSource}" />
                <ComboBox Margin="0,0,8,0" ItemsSource="{Binding Families}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedFamily}" />
                <ComboBox ItemsSource="{Binding Resolutions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedResolution}" />
            </UniformGrid>
            <TextBlock Margin="0,6,0,0" Text="{Binding Warnings}" ToolTip="{Binding Warnings}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
            <Button Margin="0,6,0,0" Content="{infra:Loc Key=CharacterShowAll}" Command="{Binding ClearCommand}" HorizontalAlignment="Left"
                    Visibility="{Binding HasRelatedFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="14,0,14,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="450" /><ColumnDefinition Width="8" /><ColumnDefinition Width="2*" MinWidth="370" /></Grid.ColumnDefinitions>
            <ListBox x:Name="ResultGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" MouseDoubleClick="OnResultDoubleClick">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="160" Margin="3" ToolTip="{Binding Source.Path}">
                            <Border Height="126" CornerRadius="4" Background="{DynamicResource SurfaceRaisedBrush}">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                                        <TextBlock Text="{Binding LoadingLabel}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                        <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" ToolTip="{Binding ThumbnailWarning}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Label}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource CaptionFontSize}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="3*" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <controls:DotNetModelPreviewHost x:Name="ModelPreview" PackagePath="{Binding PackagePath}" Prewarm="True"
                        Visibility="{Binding HasPackage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Border>
                <StackPanel Grid.Row="2" Margin="0,6">
                    <TextBlock Text="{Binding PreviewStatus}" ToolTip="{Binding PreviewStatus}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ElementName=ModelPreview, Path=StatusText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
                    <ProgressBar Height="5" Margin="0,5,0,0" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreparingPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=ModelPreview, Path=IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                <TabControl Grid.Row="3" Style="{StaticResource SettingsTabControlStyle}">
                    <TabItem Header="{infra:Loc Key=CharacterDetails}">
                        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </TabItem>
                    <TabItem Header="{infra:Loc Key=CharacterRelationships}">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Margin="0,6,0,0" Content="{infra:Loc Key=CharacterBrowseRelated}" Command="{Binding ShowRelatedRowsCommand}" />
                            <ListBox ItemsSource="{Binding RelatedRows}" DisplayMemberPath="Label" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
                <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                    <Button Margin="0,0,6,4" Content="{infra:Loc Key=ItemFinderShowExact}" Command="{Binding ShowExactCommand}" />
                    <Button Margin="0,0,6,4" Content="{infra:Loc Key=ItemFinderShowRelated}" Command="{Binding ShowRelatedFilesCommand}" />
                    <Button Margin="0,0,0,4" Content="{infra:Loc Key=CharacterCopyPath}" Click="OnCopyPathClick" />
                </WrapPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="14,10,14,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ThumbnailStatus}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
                <ProgressBar Height="4" Margin="0,4,0,0" Value="{Binding ThumbnailCount, Mode=OneWay}" Maximum="{Binding ThumbnailTotal}"
                    Visibility="{Binding IsLoadingThumbnails, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <Button Grid.Column="1" Margin="8,0,0,0" Content="{infra:Loc Key=Cancel}" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="{infra:Loc Key=PreviousPage}" Command="{Binding PreviousCommand}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Content="{infra:Loc Key=NextPage}" Command="{Binding NextCommand}" />
        </Grid>
    </Grid>
</Window>
