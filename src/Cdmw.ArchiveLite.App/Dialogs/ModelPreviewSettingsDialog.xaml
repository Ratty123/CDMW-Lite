<Window x:Class="Cdmw.ArchiveLite.App.Dialogs.ModelPreviewSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Cdmw.ArchiveLite.App.Infrastructure"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{infra:Loc Key=PreviewSettings}"
        Width="590"
        Height="500"
        MinWidth="520"
        MinHeight="440"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    CornerRadius="9,9,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" />
                    <TextBlock Grid.Column="0"
                               Margin="20,0,12,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontSize="{DynamicResource TitleFontSize}"
                               FontWeight="SemiBold"
                               Text="{infra:Loc Key=PreviewSettings}" />
                    <Button Grid.Column="1"
                            Width="46"
                            Height="54"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            ToolTip="{infra:Loc Key=Close}"
                            Content="&#x00D7;"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseClick" />
                    <Border Grid.ColumnSpan="2"
                            VerticalAlignment="Bottom"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" />
                </Grid>
            </Border>

            <TabControl x:Name="SettingsTabs"
                        Grid.Row="1"
                        Margin="20,18,20,8">
                <TabItem Header="{infra:Loc Key=CameraInput}">
                    <ScrollViewer Padding="4,14,4,4"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{infra:Loc Key=PreviewCameraInstructions}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{infra:Loc Key=OrbitSensitivity}" />
                                <Slider Grid.Column="1"
                                        Margin="10,0"
                                        Minimum="0.05"
                                        Maximum="1.0"
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding ModelPreviewOrbitSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Text="{Binding ModelPreviewOrbitSensitivity, StringFormat={}{0:F2}}" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{infra:Loc Key=PanSensitivity}" />
                                <Slider Grid.Column="1"
                                        Margin="10,0"
                                        Minimum="0.05"
                                        Maximum="3.0"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding ModelPreviewPanSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Text="{Binding ModelPreviewPanSensitivity, StringFormat={}{0:F2}}" />
                            </Grid>

                            <Border Margin="0,22,0,0"
                                    Padding="14"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox Content="{infra:Loc Key=InvertOrbitX}"
                                                  IsChecked="{Binding ModelPreviewInvertOrbitX, Mode=TwoWay}" />
                                        <CheckBox Margin="0,10,0,0"
                                                  Content="{infra:Loc Key=InvertOrbitY}"
                                                  IsChecked="{Binding ModelPreviewInvertOrbitY, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox Content="{infra:Loc Key=InvertPanX}"
                                                  IsChecked="{Binding ModelPreviewInvertPanX, Mode=TwoWay}" />
                                        <CheckBox Margin="0,10,0,0"
                                                  Content="{infra:Loc Key=InvertPanY}"
                                                  IsChecked="{Binding ModelPreviewInvertPanY, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,14,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{infra:Loc Key=PreviewCameraInputHint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2"
                    Padding="20,12"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Left"
                            Content="{infra:Loc Key=ResetCameraInput}"
                            Command="{Binding ResetModelPreviewCameraInputCommand}" />
                    <Button Grid.Column="1"
                            MinWidth="92"
                            Content="{infra:Loc Key=Close}"
                            Click="OnCloseClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
