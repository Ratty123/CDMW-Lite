<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <!-- The preview window is reparented into Archive Lite, which is PerMonitorV2. The
         WinForms default of SystemAware would leave this process measuring in the logon
         monitor's scale, so on any other scale Windows resizes the hosted window behind
         our back and the host is left showing an unpainted margin. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cdmw-mesh-dotnet-editor</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyInformationalVersion>2.0.0+resident-v2</AssemblyInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
    <PackageReference Include="Vortice.D3DCompiler" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="D3D11MaterialShaders.hlsl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="D3D11MaterialShaders.hlsl" LogicalName="D3D11MaterialShaders.hlsl" />
  </ItemGroup>
</Project>
